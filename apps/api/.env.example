OPENAI_API_KEY=your_openai_api_key_here

# Global API key gating the code-generation / execution endpoints.
# When unset the API is unauthenticated (single-user local dev only).
# Set a strong secret before exposing the API beyond localhost; clients then
# send it via `X-API-Key: <key>` or `Authorization: Bearer <key>`.
# AGNOLAB_API_KEY=change-me-to-a-long-random-secret

# Comma-separated list of browser origins allowed to call the API.
# Defaults to the local dev servers. Set to the deployed web origin in production.
# Using "*" is allowed but disables credentialed CORS for safety.
# AGNOLAB_CORS_ORIGINS=https://agnolab.example.com

# Executor guards for the isolated code runner.
# Hard ceiling (seconds) for any single run, overriding per-flow timeouts.
# AGNOLAB_MAX_EXECUTION_SECONDS=300
# Max size (MB) a generated run may write to disk.
# AGNOLAB_MAX_OUTPUT_MB=128
# Optional memory cap (MB) for a run. Off by default because ML/vector libraries
# reserve large virtual address ranges; set only for untrusted multi-tenant use.
# AGNOLAB_MAX_MEMORY_MB=2048

