# AgnoLab — production docker compose configuration.
# Copy to `.env` and fill in the required secrets:  cp .env.example .env
#
# Generate strong secrets with:  openssl rand -hex 32

# =============================================================================
# REQUIRED — docker compose will refuse to start without these.
# =============================================================================

# Gates the code-generation and execution endpoints. The API generates and RUNS
# Python code, so leaving this unset would be unauthenticated remote code
# execution for anyone who can reach the port.
# Clients send it as `X-API-Key: <key>` or `Authorization: Bearer <key>`.
AGNOLAB_API_KEY=

# Shared secret between the API and the WhatsApp (wppconnect) gateway.
WHATSAPP_GATEWAY_SECRET_KEY=

# Backing service credentials.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=

# =============================================================================
# Model providers — set the ones you use.
# =============================================================================
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=

# =============================================================================
# Networking
# =============================================================================
# Public URL browsers use to reach the API. Baked into the web build.
# VITE_API_URL=https://api.agnolab.example.com
# Browser origins allowed to call the API (comma-separated).
# AGNOLAB_CORS_ORIGINS=https://agnolab.example.com
# Host ports.
# API_PORT=8000
# WEB_PORT=5173

# =============================================================================
# Executor guards (the runner that executes generated flow code)
# =============================================================================
# Hard ceiling for any single run, overriding per-flow timeouts.
# AGNOLAB_MAX_EXECUTION_SECONDS=300
# Max size (MB) a run may write to disk.
# AGNOLAB_MAX_OUTPUT_MB=128
# Optional memory cap (MB). Off by default: ML/vector libraries reserve large
# virtual address ranges. Set it for untrusted/multi-tenant use.
# AGNOLAB_MAX_MEMORY_MB=2048
# Isolate the runner environment (default: on in production). Executed flow code
# sees only system essentials, known provider credential vars, and the flow's own
# secrets — not the full host environment.
# AGNOLAB_ISOLATE_ENV=1
# Extra host env vars to forward into the isolated runner (comma-separated).
# AGNOLAB_FORWARD_ENV=AWS_ACCESS_KEY_ID,AWS_SECRET_ACCESS_KEY

# =============================================================================
# Storage
# =============================================================================
# Where saved flows and listener state live on the host. Back this up.
# AGNOLAB_DATA_DIR=./apps/api/data

# =============================================================================
# Cloud queues — SQS and Pub/Sub are real cloud services in production.
# (The local emulators are development-only; see docker-compose.dev.yml.)
# =============================================================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# GOOGLE_APPLICATION_CREDENTIALS=

# =============================================================================
# Backing service hostnames to use INSIDE your flow nodes.
# The services are not published to the host; reach them by service name:
#
#   Postgres   postgresql+psycopg://agnolab:<POSTGRES_PASSWORD>@postgres:5432/agnolab
#   Redis      redis://:<REDIS_PASSWORD>@redis:6379/0
#   RabbitMQ   amqp://agnolab:<RABBITMQ_PASSWORD>@rabbitmq:5672/
#   Kafka      kafka:19092
#   NATS       nats://nats:4222
# =============================================================================

# Optional overrides.
# POSTGRES_USER=agnolab
# POSTGRES_DB=agnolab
# RABBITMQ_USER=agnolab
